[Unit]
Description=Smart Banking AI - OpenAI-compatible API (CISC 886 G24)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/banking
Environment="PATH=/home/ubuntu/banking/banking-env/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/banking/banking-env/bin/python3 -m llama_cpp.server \
    --model /home/ubuntu/banking/qwen2.5-1.5b-instruct-q4_k_m.gguf \
    --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
